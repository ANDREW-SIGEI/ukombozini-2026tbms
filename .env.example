# UKOMBOZI Institutional Stack - Environment Variables

# Database Configuration
DB_USER=ukombozi_user
DB_PASSWORD=ukombozi_pass
DB_NAME=ukombozi_tbms

# Security
JWT_SECRET=ukombozi-secret-key-2026

# Backend Configuration
PORT=5000
NODE_ENV=production

# URLs (Internal Docker Networking)
DATABASE_URL=postgres://ukombozi_user:ukombozi_pass@ukombozi-db:5432/ukombozi_tbms
REDIS_URL=redis://ukombozi-redis:6379
