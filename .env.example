# UKOMBOZI Institutional Stack - Environment Variables

# Database Configuration
DB_USER=ukombozi_user
DB_PASSWORD=ukombozi_pass
DB_NAME=ukombozi_tbms

# Security
JWT_SECRET=ukombozi-secret-key-2026

# Backend Configuration
PORT=5000
NODE_ENV=production

# URLs (Internal Docker Networking)
DATABASE_URL=postgres://ukombozi_user:ukombozi_pass@ukombozi-db:5432/ukombozi_tbms
REDIS_URL=redis://ukombozi-redis:6379

# Email Configuration (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# SMS Gateway (Africa's Talking / Twilio)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-api-key
SMS_SENDER_ID=UKOMBOZI
