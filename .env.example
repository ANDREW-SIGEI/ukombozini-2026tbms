# UKOMBOZINI Institutional Stack - Environment Variables

# Database Configuration
DB_USER=ukombozini_user
DB_PASSWORD=ukombozini_pass
DB_NAME=ukombozini_tbms

# Security
JWT_SECRET=ukombozini-secret-key-2026

# Backend Configuration
PORT=5000
NODE_ENV=production

# URLs (Internal Docker Networking)
DATABASE_URL=postgres://ukombozini_user:ukombozini_pass@ukombozini-db:5432/ukombozini_tbms
REDIS_URL=redis://ukombozini-redis:6379

# Email Configuration (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# SMS Gateway (Africa's Talking / Twilio)
AFRICASTALKING_USERNAME=sandbox
AFRICASTALKING_API_KEY=your-api-key
SMS_SENDER_ID=UKOMBOZINI
