# ------------------------------------------------------------------
# 🚀 UKOMBOZI TBMS - PRODUCTION ENVIRONMENT VARIABLES
# ------------------------------------------------------------------
# INSTRUCTIONS:
# 1. Rename this file to .env.production
# 2. Fill in the values below with your LIVE credentials
# 3. Upload these to Vercel (Settings -> Environment Variables)
# ------------------------------------------------------------------

# 1. SUPABASE (Database & Auth)
# Find these in Supabase Dashboard -> Project Settings -> API
REACT_APP_SUPABASE_URL=https://your-project-id.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-public-anon-key

# 2. APPLICATION IDENTITY
REACT_APP_APP_NAME="UKOMBOZI Table Banking System"
REACT_APP_APP_VERSION="1.0.0"
REACT_APP_ENVIRONMENT="production"

# 3. SMS GATEWAY (AfricasTalking)
# Optional: Leave backend defaults if processing on server
REACT_APP_SMS_API_KEY=your-live-api-key
REACT_APP_SMS_USERNAME=ukombozi_live

# 4. REPORTING (PDF Services)
REACT_APP_ORG_NAME="UKOMBOZI SELF HELP GROUP"
REACT_APP_ORG_PHONE="+254 700 000 000"
REACT_APP_ORG_EMAIL="info@ukombozi.co.ke"

# 5. SECURITY 
# Comma-separated list of allowed officer emails (if restricting registration)
REACT_APP_ALLOWED_ADMINS="director@ukombozi.co.ke,admin@ukombozi.co.ke"
