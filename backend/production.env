# Production Environment Configuration
# Rename this file to .env in your production backend directory

# Server Configuration
PORT=5000
NODE_ENV=production

# Database Configuration (ensure this path is correct relative to server.js)
DATABASE_URL=./ukombozini.sqlite

# Security (CRITICAL: Change this to a strong, long random string)
JWT_SECRET=CHANGE_ME_TO_SOMETHING_SECURE_AND_LONG_IN_PRODUCTION

# Optional: Logging
LOG_LEVEL=info
