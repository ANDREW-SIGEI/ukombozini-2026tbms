# UKOMBOZI-2026 TBMS - Environment Variables Example
# Copy this to .env and fill in the values

# Server Configuration
PORT=5000
NODE_ENV=production
JWT_SECRET=your_super_secret_jwt_key_here

# Database Configuration (SQLite)
DATABASE_PATH=./database/ukombozi.db

# Africa's Talking SMS Gateway
AT_USERNAME=sandbox
AT_API_KEY=your_at_api_key_here
AT_SENDER_ID=UKOMBOZI

# Institutional Branding & Security
ORGANIZATION_NAME="UKOMBOZI TABLE BANKING"
SYSTEM_ID=UKB-PROD-001
